diff a/client/src/styles/tv.css b/client/src/styles/tv.css	(rejected hunks)
@@ -707,3 +707,267 @@
     animation: none !important;
   }
 }
+
+/* ========================================
+   REVISION 3 — ACCESSIBLE SCREEN PALETTE
+   The physical HM/CH/SV/IN/VHS/Power hardware styling above is preserved.
+   ======================================== */
+
+.tv-perspective-container {
+  background: var(--ui-bg);
+}
+
+.tv-perspective-container.high-contrast {
+  background: #121212;
+}
+
+.tv-on .tv-screen {
+  background: var(--ui-bg);
+}
+
+.tv-screen-header {
+  min-height: 56px;
+  padding-top: 0.65rem;
+  padding-bottom: 0.65rem;
+  background: linear-gradient(to bottom, var(--ui-overlay), transparent);
+}
+
+.screen-back-button {
+  width: 44px;
+  height: 44px;
+  flex: 0 0 44px;
+  border: 1px solid var(--ui-accent);
+  background: var(--ui-surface);
+  color: var(--ui-accent);
+}
+
+.screen-back-button:hover {
+  border-color: var(--ui-accent);
+  background: var(--ui-surface);
+  color: var(--ui-accent);
+  box-shadow: 0 0 16px var(--ui-accent-glow);
+}
+
+.screen-back-button:focus-visible {
+  outline: 3px solid var(--ui-accent);
+  outline-offset: 2px;
+  border-color: var(--ui-accent);
+  background: var(--ui-surface);
+  color: var(--ui-accent);
+}
+
+.screen-page-label {
+  color: var(--ui-text) !important;
+  font-size: 1rem !important;
+  line-height: 1.4;
+  letter-spacing: 0.12em;
+  text-shadow: none;
+}
+
+.contrast-toggle {
+  min-width: 44px;
+  min-height: 44px;
+  margin-left: auto;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.45rem;
+  padding: 0.45rem 0.7rem;
+  border: 1px solid var(--ui-accent);
+  border-radius: 6px;
+  background: var(--ui-surface);
+  color: var(--ui-text);
+  font-family: 'Space Mono', monospace;
+  font-size: 1rem;
+  font-weight: 700;
+  line-height: 1;
+  cursor: pointer;
+  pointer-events: auto;
+  transition: box-shadow 160ms ease, background 160ms ease, color 160ms ease;
+}
+
+.contrast-toggle:hover {
+  box-shadow: 0 0 16px var(--ui-accent-glow);
+}
+
+.contrast-toggle:focus-visible {
+  outline: 3px solid var(--ui-accent);
+  outline-offset: 2px;
+}
+
+.contrast-toggle.active {
+  background: var(--ui-accent);
+  color: var(--ui-bg);
+}
+
+.contrast-icon {
+  color: var(--ui-accent);
+  font-size: 1rem;
+  line-height: 1;
+}
+
+.contrast-toggle.active .contrast-icon,
+.contrast-toggle.active .contrast-label {
+  color: var(--ui-bg);
+}
+
+.contrast-label {
+  color: inherit;
+  font-size: inherit;
+}
+
+.tv-screen-glow {
+  background:
+    linear-gradient(112deg, rgba(255, 255, 255, 0.04), transparent 25% 72%, rgba(255, 255, 255, 0.02)),
+    radial-gradient(ellipse at center, transparent 68%, rgba(0, 0, 0, 0.25) 100%);
+}
+
+.tv-content {
+  padding-top: clamp(4.6rem, 8vh, 5.4rem);
+  color: var(--ui-text);
+  scrollbar-color: var(--ui-muted) transparent;
+}
+
+/* Keep all persistent VHS / CRT overlays at 10% opacity or lower. */
+.vhs-noise {
+  opacity: 0.05;
+}
+
+.vhs-scanlines {
+  opacity: 0.08;
+  background: repeating-linear-gradient(
+    to bottom,
+    transparent 0,
+    transparent 3px,
+    rgba(0, 0, 0, 0.10) 3px,
+    rgba(0, 0, 0, 0.10) 4px
+  );
+}
+
+.vhs-tracking-line {
+  background: linear-gradient(
+    to bottom,
+    transparent,
+    rgba(255, 255, 255, 0.04),
+    rgba(255, 255, 255, 0.08),
+    transparent
+  );
+}
+
+@keyframes vhs-track {
+  0%, 58% { transform: translateY(0); opacity: 0; }
+  61% { opacity: 0.10; }
+  75% { transform: translateY(980%); opacity: 0.06; }
+  76%, 100% { transform: translateY(980%); opacity: 0; }
+}
+
+/* Accessibility focus rings are additive and do not alter the approved bezel styling. */
+.tv-control-button:focus-visible:not(:disabled),
+.tv-power-button:focus-visible:not(:disabled) {
+  outline: 3px solid var(--ui-accent);
+  outline-offset: 2px;
+}
+
+@media (max-width: 767px) {
+  .tv-perspective-container,
+  .tv-frame,
+  .tv-screen-bezel {
+    background: var(--ui-bg);
+  }
+
+  .tv-on .tv-screen {
+    background: var(--ui-bg);
+  }
+
+  .tv-screen-header {
+    min-height: 62px;
+    padding: max(0.55rem, env(safe-area-inset-top)) 0.75rem 0.55rem;
+    background: linear-gradient(to bottom, var(--ui-overlay), transparent);
+  }
+
+  .screen-back-button {
+    width: 44px;
+    height: 44px;
+    flex-basis: 44px;
+  }
+
+  .screen-page-label {
+    font-size: 1rem !important;
+    letter-spacing: 0.08em;
+  }
+
+  .contrast-toggle {
+    width: 44px;
+    padding: 0;
+  }
+
+  .contrast-label {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  .tv-content {
+    padding: calc(max(0.75rem, env(safe-area-inset-top)) + 4.2rem) 0.9rem 1.25rem;
+  }
+
+  /* Preserve the approved portable-receiver bezel design while meeting 44px touch targets. */
+  .tv-control-button,
+  .tv-power-button {
+    min-height: 44px;
+  }
+
+  .tv-power-button {
+    width: 44px;
+    min-width: 44px;
+  }
+}
+
+.tv-off-screen,
+.tv-boot-sequence {
+  background: var(--ui-bg);
+  color: var(--ui-text);
+}
+
+.tv-off-screen p,
+.tv-off-screen span {
+  color: var(--ui-text) !important;
+  font-size: 1rem !important;
+  line-height: 1.6;
+}
+
+.standby-pixel,
+.boot-beam {
+  background: var(--ui-accent);
+  box-shadow: 0 0 14px var(--ui-accent-glow);
+}
+
+.boot-copy {
+  background: var(--ui-overlay);
+}
+
+.boot-copy strong,
+.boot-copy small {
+  color: var(--ui-text);
+}
+
+.boot-copy span {
+  color: var(--ui-text) !important;
+  font-size: 1rem !important;
+}
+
+.boot-copy span::before {
+  content: '● ';
+  color: var(--ui-accent);
+}
+
+.boot-copy small {
+  font-size: 1rem;
+  line-height: 1.6;
+}
